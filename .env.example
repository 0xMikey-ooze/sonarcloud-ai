# ============================================
# Newsletter Configuration
# ============================================

# Resend API Key - Get yours at https://resend.com
RESEND_API_KEY=re_your_api_key_here

# Sender email address (must be verified in Resend)
NEWSLETTER_FROM_EMAIL=newsletter@yourdomain.com

# Comma-separated list of recipient emails
NEWSLETTER_RECIPIENTS=parent1@example.com,educator@school.edu

# ============================================
# Content Sources
# ============================================

# TinyFish API Key - for web search and content fetching
# Get started at https://www.tinyfish.ai/
TINYFISH_API_KEY=tf_your_api_key_here

# Last30Days memory directory (where brief files are saved)
# Defaults to ~/Documents/Last30Days
LAST30DAYS_MEMORY_DIR=/Users/you/Documents/Last30Days

# ============================================
# AI Curation (DeepSeek V4)
# ============================================

DEEPSEEK_API_KEY=your_deepseek_key_here

# ============================================
# Social & Video Sources
# ============================================

# Twitter/X Bearer Token (https://developer.twitter.com/)
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# YouTube Data API v3 Key (https://console.cloud.google.com/)
YOUTUBE_API_KEY=your_youtube_api_key

# Perplexity API Key (https://www.perplexity.ai/settings/api)
PERPLEXITY_API_KEY=your_perplexity_key

# TikTok Research API (requires approval: https://developers.tiktok.com/)
TIKTOK_API_KEY=your_tiktok_key

# Instagram Graph API (requires business account)
INSTAGRAM_ACCESS_TOKEN=your_instagram_token

# Threads API (requires Meta developer account)
THREADS_ACCESS_TOKEN=your_threads_token

# ============================================
# Existing Project Config (keep these)
# ============================================

ANTHROPIC_API_KEY=your_anthropic_key
NOTION_API_KEY=your_notion_key
NOTION_DATABASE_ID=your_database_id
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
