rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Tours - public read, admin write
    match /tours/{tourId} {
      allow read: if true; // Public read
      allow write: if false; // Admin SDK only (server-side)
    }
    
    // Bookings - admin read (for admin portal), admin write via API
    match /bookings/{bookingId} {
      allow read: if true; // Public read for admin portal (protected by Clerk)
      allow write: if false; // Admin SDK only (via API routes)
    }
    
    // Coupons - public read for validation, admin write
    match /coupons/{couponId} {
      allow read: if true; // Public read for validation
      allow write: if false; // Admin SDK only
    }
    
    // Tips - admin read (for admin portal), admin write via API
    match /tips/{tipId} {
      allow read: if true; // Public read for admin portal (protected by Clerk)
      allow write: if false; // Admin SDK only (via API routes)
    }
    
    // Spin attempts - admin read/write only
    match /spin_attempts/{attemptId} {
      allow read, write: if false; // Admin SDK only
    }
    
    // Referral partners - admin read (for admin portal), admin write via API
    match /referral_partners/{partnerId} {
      allow read: if true; // Public read for admin portal (protected by Clerk)
      allow write: if false; // Admin SDK only (via API routes)
    }
    
    // Referral earnings - admin read/write only
    match /referral_earnings/{earningId} {
      allow read, write: if false; // Admin SDK only
    }
    
    // Referral scans - admin read/write only
    match /referral_scans/{scanId} {
      allow read, write: if false; // Admin SDK only
    }
    
    // OTP codes - admin read/write only
    match /otp_codes/{otpId} {
      allow read, write: if false; // Admin SDK only
    }
    
    // Processed events (webhook idempotency) - admin read/write only
    match /processed_events/{eventId} {
      allow read, write: if false; // Admin SDK only
    }
    
    // POS Products - public read (for POS system), admin write via API
    match /pos_products/{productId} {
      allow read: if true; // Public read for POS system
      allow write: if false; // Admin SDK only (via API routes)
    }
    
    // Vendors - admin read (for admin portal), admin write via API
    match /vendors/{vendorId} {
      allow read: if true; // Public read for admin portal (protected by Clerk)
      allow write: if false; // Admin SDK only (via API routes)
    }
    
    // Reviews - admin read (for admin portal), admin write via API
    match /reviews/{reviewId} {
      allow read: if true; // Public read for admin portal (protected by Clerk)
      allow write: if false; // Admin SDK only (via API routes)
    }
    
    // Default: deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
